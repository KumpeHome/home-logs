APP_NAME=Home Logs
DATABASE_URL=mysql+pymysql://homelogs:homelogs@localhost:3306/homelogs
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:4200

OIDC_ISSUER=http://localhost:3301
OIDC_AUDIENCE=https://homelogs.app/api
OIDC_JWKS_URL=
OIDC_CLIENT_ID=home-logs-spa
OIDC_CLIENT_SECRET=
# Identity scopes only. RBAC scopes (homelogs:…:…) are always appended by the SPA.
OIDC_SCOPES=openid profile email

OIDC_M2M_CLIENT_ID=
OIDC_M2M_CLIENT_SECRET=
OIDC_MANAGEMENT_API=

# Dev only — skip KumpeCloud Auth / OIDC. Never enable in production.
AUTH_DISABLED=true
AUTH_BYPASS_EMAIL=
AUTH_BYPASS_SUBJECT=

# Public site URL. Pushover subscription "base URL" must be this origin.
PUBLIC_APP_URL=http://localhost:4200

# Email reminders. Leave SMTP_HOST empty to disable email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Pushover. Create an application, then a web subscription whose base URL is PUBLIC_APP_URL.
# Subscription URL looks like https://pushover.net/subscribe/YourApp-code
PUSHOVER_API_TOKEN=
PUSHOVER_SUBSCRIPTION_URL=
PUSHOVER_SUBSCRIPTION_CODE=

# How often to send due medication and refill reminders, in seconds. 0 disables the poller.
NOTIFICATION_POLL_SECONDS=60
