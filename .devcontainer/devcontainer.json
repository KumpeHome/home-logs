{
  "name": "Home Logs",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "backend",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "angular.ng-template"
      ]
    }
  },
  "postCreateCommand": "cd backend && python -m venv .venv && .venv/bin/pip install -e '.[dev]'"
}
